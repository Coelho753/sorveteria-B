# Copy this file to .env for local development. Never commit your real .env.
PORT=3000
NODE_ENV=development

# Atlas: paste the complete connection string from MongoDB Atlas/Render here.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=AylaSorvetes
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=AylaSorvetes

# Use separate secrets with at least 32 characters each.
JWT_SECRET=replace_with_a_32_character_minimum_access_secret
JWT_REFRESH_SECRET=replace_with_a_32_character_minimum_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated production frontend origins. localhost is accepted automatically.
CORS_ORIGINS=https://sorveteriaayla.com.br,https://www.sorveteriaayla.com.br

# Optional: creates this admin only when the users collection is empty.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_secure_password

# Optional: shared secret that unlocks POST /admin/bootstrap-role, which promotes
# any existing email to admin without needing a prior admin session. Treat this
# like a master password - generate with `openssl rand -hex 32` and never commit it.
ADMIN_BOOTSTRAP_SECRET=

WHATSAPP_WEBHOOK_SECRET=replace_with_a_webhook_secret
WHATSAPP_PHONE=5511965474023
STORE_ADDRESS=
STORE_HOURS=

